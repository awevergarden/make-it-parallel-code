# Makefile -- Chapter 6 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = daxpy reduce vpatterns

all: $(PROGS)

daxpy: daxpy.c ../common/timer.h
	gcc -std=c17 -O2 -fopenmp-simd -Wall -Wextra -o daxpy \
	    daxpy.c

reduce: reduce.c ../common/timer.h
	gcc -std=c17 -O2 -fopenmp-simd -Wall -Wextra -o reduce \
	    reduce.c

vpatterns: vpatterns.c ../common/timer.h
	gcc -std=c17 -O2 -fopenmp-simd -Wall -Wextra -o \
	    vpatterns vpatterns.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
