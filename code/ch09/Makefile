# Makefile -- Chapter 9 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = fork_demo pingpong pipe_capacity pipe_deadlock \
        shm_demo sum_server

all: $(PROGS)

fork_demo: fork_demo.c
	gcc -std=c17 -O2 -Wall -Wextra -o fork_demo fork_demo.c

pingpong: pingpong.c io_all.h ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o pingpong pingpong.c

pipe_capacity: pipe_capacity.c
	gcc -std=c17 -O2 -Wall -Wextra -o pipe_capacity \
	    pipe_capacity.c

pipe_deadlock: pipe_deadlock.c io_all.h
	gcc -std=c17 -O2 -Wall -Wextra -o pipe_deadlock \
	    pipe_deadlock.c

shm_demo: shm_demo.c
	gcc -std=c17 -O2 -Wall -Wextra -o shm_demo shm_demo.c

sum_server: sum_server.c io_all.h ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o sum_server \
	    sum_server.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
