	gcc -std=c17 -O2 -Wall -Wextra -o cristian cristian.c

events: events.c
	mpicc -std=c17 -O2 -Wall -Wextra -o events events.c

tobcast: tobcast.c
	mpicc -std=c17 -O2 -Wall -Wextra -o tobcast tobcast.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
