# Makefile -- Chapter 17 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = banker cmh heartbeat lease mutex

all: $(PROGS)

banker: banker.c
	gcc -std=c17 -O2 -Wall -Wextra -o banker banker.c

cmh: cmh.c
	mpicc -std=c17 -O2 -Wall -Wextra -o cmh cmh.c

heartbeat: heartbeat.c
	gcc -std=c17 -O2 -Wall -Wextra -o heartbeat heartbeat.c

lease: lease.c
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o lease \
	    lease.c

mutex: mutex.c
	mpicc -std=c17 -O2 -Wall -Wextra -o mutex mutex.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
