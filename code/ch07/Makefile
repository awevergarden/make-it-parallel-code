# Makefile -- Chapter 7 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = costs false_sharing launcher_threads lock_order \
        queue race sem_queue

all: $(PROGS)

costs: costs.c ../common/barrier.h ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o costs \
	    costs.c

false_sharing: false_sharing.c ../common/barrier.h ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o \
	    false_sharing false_sharing.c

launcher_threads: launcher_threads.c
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o \
	    launcher_threads launcher_threads.c

lock_order: lock_order.c ../common/barrier.h
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o lock_order \
	    lock_order.c

queue: queue.c ../common/barrier.h ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o queue \
	    queue.c

race: race.c ../common/barrier.h ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o race race.c

sem_queue: sem_queue.c ../common/barrier.h
	gcc -std=c17 -O2 -Wall -Wextra -pthread -o sem_queue \
	    sem_queue.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
