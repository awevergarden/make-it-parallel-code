# Makefile -- Chapter 3 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = dce profile_demo timer_res wall_vs_cpu

all: $(PROGS)

dce: dce.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o dce dce.c

profile_demo: profile_demo.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o profile_demo \
	    profile_demo.c

timer_res: timer_res.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o timer_res timer_res.c

wall_vs_cpu: wall_vs_cpu.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o wall_vs_cpu \
	    wall_vs_cpu.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
