# Makefile -- Chapter 13 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = mm_dist strassen

all: $(PROGS)

mm_dist: mm_dist.c
	mpicc -std=c17 -O2 -Wall -Wextra -o mm_dist mm_dist.c \
	    -lm

strassen: strassen.c ../common/timer.h
	gcc -std=c17 -O2 -fopenmp-simd -Wall -Wextra -o \
	    strassen strassen.c -lm

clean:
	rm -f $(PROGS)

.PHONY: all clean
