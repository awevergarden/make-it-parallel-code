# Makefile -- Chapter 18 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = elect raftsim twopc

all: $(PROGS)

elect: elect.c
	gcc -std=c17 -O2 -Wall -Wextra -o elect elect.c

raftsim: raftsim.c
	gcc -std=c17 -O2 -Wall -Wextra -o raftsim raftsim.c

twopc: twopc.c
	mpicc -std=c17 -O2 -Wall -Wextra -o twopc twopc.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
