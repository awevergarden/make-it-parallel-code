PROGS = bandwidth conflict latency matmul peak stride \
        transpose

all: $(PROGS)

bandwidth: bandwidth.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o bandwidth bandwidth.c

conflict: conflict.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o conflict conflict.c

latency: latency.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o latency latency.c

matmul: matmul.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o matmul matmul.c

peak: peak.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o peak peak.c

stride: stride.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o stride stride.c

transpose: transpose.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o transpose transpose.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
