# Makefile -- Chapter 10 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = exchange mpi_bugs mpi_hello pingpong_mpi \
        reduce_mpi scatterv_demo topology

all: $(PROGS)

exchange: exchange.c
	mpicc -std=c17 -O2 -Wall -Wextra -o exchange exchange.c

mpi_bugs: mpi_bugs.c
	mpicc -std=c17 -O2 -Wall -Wextra -o mpi_bugs mpi_bugs.c

mpi_hello: mpi_hello.c
	mpicc -std=c17 -O2 -Wall -Wextra -o mpi_hello \
	    mpi_hello.c

pingpong_mpi: pingpong_mpi.c
	mpicc -std=c17 -O2 -Wall -Wextra -o pingpong_mpi \
	    pingpong_mpi.c

reduce_mpi: reduce_mpi.c
	mpicc -std=c17 -O2 -Wall -Wextra -o reduce_mpi \
	    reduce_mpi.c

scatterv_demo: scatterv_demo.c
	mpicc -std=c17 -O2 -Wall -Wextra -o scatterv_demo \
	    scatterv_demo.c

topology: topology.c
	mpicc -std=c17 -O2 -Wall -Wextra -o topology topology.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
