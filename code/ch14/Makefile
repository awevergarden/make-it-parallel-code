# Makefile -- Chapter 14 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make cuda    build the CUDA programs (needs NVIDIA's nvcc)
# make clean   remove everything make built

PROGS = emulate_matmul emulate_reduce emulate_v8 \
        heat_target
CUDA_PROGS = matmul_gpu

all: $(PROGS)

cuda: $(CUDA_PROGS)

emulate_matmul: emulate_matmul.c ../heatsim/matmul_tile.h
	gcc -std=c17 -O2 -Wall -Wextra -o emulate_matmul \
	    emulate_matmul.c

emulate_reduce: emulate_reduce.c ../heatsim/reduce_block.h
	gcc -std=c17 -O2 -Wall -Wextra -o emulate_reduce \
	    emulate_reduce.c

emulate_v8: emulate_v8.c ../heatsim/heatsim_cell.h
	gcc -std=c17 -O2 -Wall -Wextra -o emulate_v8 \
	    emulate_v8.c

heat_target: heat_target.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o heat_target \
	    heat_target.c

matmul_gpu: matmul_gpu.cu ../heatsim/matmul_tile.h
	nvcc -O2 -arch=sm_80 -o matmul_gpu matmul_gpu.cu

clean:
	rm -f $(PROGS) $(CUDA_PROGS)

.PHONY: all clean cuda
