# Makefile -- Chapter 8 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = histogram matmul_omp reduce_omp scan schedule \
        sum_bug task_sum

all: $(PROGS)

histogram: histogram.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o histogram \
	    histogram.c

matmul_omp: matmul_omp.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o matmul_omp \
	    matmul_omp.c

reduce_omp: reduce_omp.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o reduce_omp \
	    reduce_omp.c

scan: scan.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o scan scan.c

schedule: schedule.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o schedule \
	    schedule.c

sum_bug: sum_bug.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o sum_bug \
	    sum_bug.c

task_sum: task_sum.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o task_sum \
	    task_sum.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
