# Makefile -- Chapter 4 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = accum branch instr_cost pattern

all: $(PROGS)

accum: accum.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o accum accum.c

branch: branch.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o branch branch.c

instr_cost: instr_cost.c ../common/timer.h
	gcc -std=c17 -O2 -fno-tree-vectorize -Wall -Wextra -o \
	    instr_cost instr_cost.c -lm

pattern: pattern.c ../common/timer.h
	gcc -std=c17 -O2 -fno-if-conversion -fno-if-conversion2 \
	    -fno-tree-vectorize -Wall -Wextra -o pattern \
	    pattern.c

clean:
	rm -f $(PROGS)

.PHONY: all clean
