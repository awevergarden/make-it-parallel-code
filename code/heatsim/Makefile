# Makefile -- HeatSim versions 1 to 8, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make cuda    build the CUDA programs (needs NVIDIA's nvcc)
# make clean   remove everything make built

PROGS = heatsim_seq heatsim_v2 heatsim_v3 heatsim_v4 \
        heatsim_v5 heatsim_v6 heatsim_v7
CUDA_PROGS = heatsim_v8

all: $(PROGS)

cuda: $(CUDA_PROGS)

heatsim_seq: heatsim_seq.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o heatsim_seq \
	    heatsim_seq.c

heatsim_v2: heatsim_v2.c ../common/timer.h
	gcc -std=c17 -O2 -Wall -Wextra -o heatsim_v2 \
	    heatsim_v2.c

heatsim_v3: heatsim_v3.c ../common/timer.h
	gcc -std=c17 -O2 -fopenmp-simd -Wall -Wextra -o \
	    heatsim_v3 heatsim_v3.c

heatsim_v4: heatsim_v4.c ../common/barrier.h ../common/timer.h
	gcc -std=c17 -O2 -fopenmp-simd -pthread -Wall -Wextra \
	    -o heatsim_v4 heatsim_v4.c

heatsim_v5: heatsim_v5.c
	gcc -std=c17 -O2 -fopenmp -Wall -Wextra -o heatsim_v5 \
	    heatsim_v5.c

heatsim_v6: heatsim_v6.c
	mpicc -std=c17 -O2 -fopenmp-simd -Wall -Wextra -o \
	    heatsim_v6 heatsim_v6.c

heatsim_v7: heatsim_v7.c
	mpicc -std=c17 -O2 -fopenmp -Wall -Wextra -o heatsim_v7 \
	    heatsim_v7.c

heatsim_v8: heatsim_v8.cu heatsim_cell.h
	nvcc -O2 -arch=sm_80 -o heatsim_v8 heatsim_v8.cu

clean:
	rm -f $(PROGS) $(CUDA_PROGS)

.PHONY: all clean cuda
