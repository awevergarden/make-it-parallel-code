# Makefile -- Chapter 15 programs, Make It Parallel.
# Generated by kit/make_makefiles.py from each program's Build line.
# make         build every C program
# make clean   remove everything make built

PROGS = systolic train_mpi

all: $(PROGS)

systolic: systolic.c
	gcc -std=c17 -O2 -Wall -Wextra -o systolic systolic.c

train_mpi: train_mpi.c
	mpicc -std=c17 -O2 -Wall -Wextra -o train_mpi \
	    train_mpi.c -lm

clean:
	rm -f $(PROGS)

.PHONY: all clean
